# Public — safe to expose to the browser (used by the anon Supabase client,
# which is subject to Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it from
# any file that can end up in a client bundle. Required for
# `supabase.auth.admin.createUser` when an admin creates a new employee
# account (there is no public sign-up flow in this app — see
# src/lib/supabase/admin.ts for the one place this key is used).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
